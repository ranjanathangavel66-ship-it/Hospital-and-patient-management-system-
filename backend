from flask import Flask, request, jsonify
import sqlite3

app = Flask(__name__)

def connect():
    return sqlite3.connect("hospital.db")

@app.route("/patients", methods=["GET"])
def get_patients():
    db = connect()
    rows = db.execute("SELECT * FROM patients").fetchall()
    db.close()

    patients = []

    for r in rows:
        patients.append({
            "id": r[0],
            "name": r[1],
            "age": r[2],
            "gender": r[3],
            "phone": r[4],
            "department": r[5],
            "doctor": r[6]
        })

    return jsonify(patients)

@app.route("/patients", methods=["POST"])
def add_patient():
    data = request.json

    db = connect()

    db.execute("""
        INSERT INTO patients
        (name, age, gender, phone, department, doctor)
        VALUES (?, ?, ?, ?, ?, ?)
    """, (
        data["name"],
        data["age"],
        data["gender"],
        data["phone"],
        data["department"],
        data["doctor"]
    ))

    db.commit()
    db.close()

    return {"message": "Patient added successfully"}

if __name__ == "__main__":
    app.run(debug=True)
